# <source path in the checkout>   <destination dir under the package root>
# Consumed by runtime/packaging/build-deb.sh (and dh_install on a full build
# host). Directories are copied recursively; a trailing "/." copies contents.
# The /usr/bin/brain-* wrappers are generated by build-deb.sh, not listed here.

# Importable library -> Debian's python3 dist-packages (on the default sys.path;
# no .pth and no dist-info, so brain_core.version falls back to dpkg-query).
runtime/lib/.                 usr/lib/python3/dist-packages

# CLI scripts, hooks, MCP server, schemas and vault-init templates.
runtime/bin                  usr/share/brain/runtime
runtime/hooks                usr/share/brain/runtime
runtime/mcp                  usr/share/brain/runtime
runtime/schemas              usr/share/brain/runtime
runtime/templates            usr/share/brain/runtime

# spec, the curated seed set and the bootstrap scripts. setup-brain-v2.sh
# prefers $SCRIPT_DIR/{roles,teams,doctrine,skills} and
# $SCRIPT_DIR/config/routing.json over the sparser runtime/templates/v2 copies;
# the package must carry them or a fresh vault is missing role personas and the
# doctrine files the personas reference, and brain-validate errors.
spec                         usr/share/brain
roles                        usr/share/brain
teams                        usr/share/brain
doctrine                     usr/share/brain
skills                       usr/share/brain
config                       usr/share/brain
prd/_TEMPLATE.md             usr/share/brain/prd
setup-brain-v2.sh            usr/share/brain
add-teams-brain.sh           usr/share/brain
add-pm-finance-brain.sh      usr/share/brain
add-design-negotiator-brain.sh usr/share/brain
add-power-features-brain.sh  usr/share/brain
patch-brain-run-doctrine.sh  usr/share/brain
refine-tax-boundaries.sh     usr/share/brain
install-brain-mcp.sh         usr/share/brain
install-hooks.sh             usr/share/brain
install-obsidian-skills.sh   usr/share/brain
