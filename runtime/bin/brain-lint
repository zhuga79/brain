#!/usr/bin/env python3
"""Lint Brain wiki hygiene and optionally regenerate wiki/index.md."""

from __future__ import annotations

import argparse
import os
import sys
from pathlib import Path

try:
    import brain_wiki
except ImportError as exc:
    print(f"ERROR: cannot import brain_wiki: {exc}", file=sys.stderr)
    sys.exit(1)


def main() -> int:
    parser = argparse.ArgumentParser(description="Lint Brain wiki/index/lock hygiene.")
    parser.add_argument("--brain", default=os.environ.get("BRAIN_PATH", str(Path.home() / "brain")))
    parser.add_argument("--fix-index", action="store_true", help="Regenerate wiki/index.md only.")
    parser.add_argument("--quiet", action="store_true")
    parser.add_argument("--sync-report", action="store_true", help="Show Obsidian views sync report.")
    args = parser.parse_args()

    brain = brain_wiki.brain_path(args.brain)

    if args.fix_index:
        path = brain_wiki.render_index(brain)
        brain_wiki.append_log(brain, "lint", "", "", "fix-index")
        if not args.quiet:
            print(f"OK: regenerated {path.relative_to(brain)}")

    issues = brain_wiki.lint_wiki(brain)
    for issue in issues:
        print(issue.format())

    if not issues and not args.quiet:
        print("OK: Brain lint passed")

    if args.sync_report or not args.quiet:
        report = brain_wiki.obsidian_sync_report(brain)
        print()
        print("--- Obsidian views sync-report ---")
        for view in report["views"]:
            status = "OK" if view["present"] else "MISSING"
            print(f"  [{status}] {view['name']} ({view['type']})")
        print(report["message"])

    return 1 if any(issue.severity == "ERROR" for issue in issues) else 0


if __name__ == "__main__":
    raise SystemExit(main())
