#!/usr/bin/env bash
# brain-prd {init|decompose|commit|dry-run|status|list} [task-id]
set -e
# shellcheck source=./brain-common
source "$(dirname "${BASH_SOURCE[0]}")/brain-common"
mkdir -p "$PRD_DIR"

cmd="${1:-}"; id="${2:-}"

case "$cmd" in
  init)
    [ -z "$id" ] && { echo "task id required"; exit 1; }
    f="$PRD_DIR/$id.md"
    [ -f "$f" ] && { echo "$f already exists"; exit 1; }
    # извлечь title из active.md
    title=$(grep -E "^- \[.\].*$id" "$A" 2>/dev/null | head -1 \
            | sed -E 's/.*— *(.+)$/\1/' || echo "TODO")
    sed "s/<task-id>/$id/; s/<ts>/$(ts)/; s/<Title>/$title/" \
        "$PRD_DIR/_TEMPLATE.md" > "$f"
    log_op "prd-init" "$id" ""
    echo "created: $f"
    echo "Заполни PRD и запусти: brain-prd commit $id"
    ;;
  decompose)
    [ -z "$id" ] && { echo "task id required"; exit 1; }
    f="$PRD_DIR/$id.md"
    [ ! -f "$f" ] && { echo "no PRD at $f"; exit 1; }

    # --- parse flags ---
    _llm_provider=""
    _do_commit=0
    _dry_run=1
    _args=("${@:3}")
    for (( _i=0; _i<${#_args[@]}; _i++ )); do
      case "${_args[$_i]}" in
        --llm)
          (( _i+1 < ${#_args[@]} )) && { _llm_provider="${_args[$(( _i+1 ))]}"; (( _i++ )) || true; }
          ;;
        --commit)   _do_commit=1; _dry_run=0 ;;
        --dry-run)  _dry_run=1;  _do_commit=0 ;;
      esac
    done

    [ -z "$_llm_provider" ] && { echo "--llm <provider> is required for decompose"; exit 1; }

    # --- resolve provider command from matrix ---
    _bin_dir="$(dirname "${BASH_SOURCE[0]}")"
    _provider_cmd=$(python3 - "$_llm_provider" "$_bin_dir" <<'PY'
import sys, pathlib, json
provider_name = sys.argv[1]
bin_dir = pathlib.Path(sys.argv[2])
brain_home = pathlib.Path.home() / "brain"
import brain_provider
matrix = brain_provider.load_provider_matrix(brain_home)
# Search all roles for this provider name
for role_candidates in matrix.get("roles", {}).values():
    for candidate in role_candidates:
        if candidate.get("provider", "").lower() == provider_name.lower():
            print(candidate["command"])
            sys.exit(0)
# Try direct name as command
print(provider_name)
PY
    )

    # --- build prompt from template ---
    _tmpl_dir="$(dirname "${BASH_SOURCE[0]}")/../templates"
    _prompt_tmpl="$_tmpl_dir/prd-decompose-prompt.txt"
    if [ ! -f "$_prompt_tmpl" ]; then
      echo "error: prompt template not found at $_prompt_tmpl" >&2
      exit 1
    fi
    _prd_text=$(cat "$f")
    _prompt=$(python3 -c "
import sys
tmpl = open(sys.argv[1]).read()
prd  = open(sys.argv[2]).read()
print(tmpl.replace('{prd_text}', prd))
" "$_prompt_tmpl" "$f")

    # --- call LLM (secrets via env only, never CLI args) ---
    echo "[decompose] calling provider: $_provider_cmd" >&2
    _llm_output=$(echo "$_prompt" | $_provider_cmd --print 2>/dev/null \
                  || echo "$_prompt" | $_provider_cmd -p 2>/dev/null \
                  || echo "$_prompt" | $_provider_cmd 2>/dev/null \
                  || true)

    # --- parse LLM output into task blocks ---
    _agent="claude-brain-prd-decompose"
    _result=$(python3 - "$_llm_output" "$id" "$_do_commit" "$A" "$LOG" "$_agent" "$_bin_dir" "$f" <<'PY'
import sys, re, datetime, pathlib

llm_output, parent_id, do_commit, active_path, log_path, agent_id, bin_dir, prd_path = sys.argv[1:9]
do_commit = (do_commit == "1")

import brain_task_parser

# --- parse blocks from LLM output ---
blocks = brain_task_parser.find_blocks(llm_output) if llm_output.strip() else []

STUB_TASKS = [
    ("P1", "s1-design",   "Describe design decisions",  "developer", "solo",   "Design doc written"),
    ("P1", "s2-implement","Implement core feature",      "developer", "solo",   "Feature passes tests"),
    ("P2", "s3-test",     "Write and run tests",         "reviewer",  "solo",   "Coverage >= 80%"),
]

used_stub = False
if not blocks:
    print("[decompose] WARNING: LLM returned no valid task blocks — using stub skeleton", file=sys.stderr)
    used_stub = True
    lines = []
    for prio, sid, title, role, mode, acc in STUB_TASKS:
        lines.append(f"- [ ] [{prio}] {sid} — {title}")
        lines.append(f"      role: {role}")
        lines.append(f"      mode: {mode}")
        lines.append(f"      acceptance: {acc}")
        lines.append("")
    blocks = brain_task_parser.find_blocks("\n".join(lines))

# --- normalize ids and add parent ---
normalized = []
local_to_full = {}
for b in blocks:
    parsed = brain_task_parser.parse_block(b)
    if not parsed:
        continue
    prio, local_id, title = parsed["prio"], parsed["id"], parsed["title"]
    full_id = local_id if local_id.startswith("t-") else f"{parent_id}-{local_id}"
    local_to_full[local_id] = full_id
    normalized.append((prio, full_id, title, b, parsed))

out_blocks = []
for prio, full_id, title, original, parsed in normalized:
    body_lines = original.split("\n")[1:]
    new_body = []
    for line in body_lines:
        line2 = re.sub(
            r"depends_on: *\[([^\]]*)\]",
            lambda mm: "depends_on: [" + ", ".join(
                local_to_full.get(d.strip(), d.strip())
                for d in mm.group(1).split(",") if d.strip()
            ) + "]",
            line,
        )
        new_body.append(line2)
    if not any("parent:" in l for l in new_body):
        new_body.insert(0, f"      parent: {parent_id}")
    if not any(re.match(r"\s*role:\s*\S+", l) for l in new_body):
        new_body.insert(1, "      role: developer")
    if not any(re.match(r"\s*mode:\s*\S+", l) for l in new_body):
        new_body.insert(2, "      mode: solo")
    if not any(re.match(r"\s*depends_on:\s*\[", l) for l in new_body):
        new_body.insert(3, "      depends_on: []")
    out_blocks.append(f"- [ ] [{prio}] {full_id} — {title}\n" + "\n".join(new_body))

if do_commit:
    # write to PRD ## Subtasks section (overwrite)
    p_path = pathlib.Path(prd_path)
    prd_text = p_path.read_text()
    sub_text = "## Subtasks\n" + "\n\n".join(out_blocks)
    if "## Subtasks" in prd_text:
        new_prd = re.sub(r"## Subtasks.*", sub_text, prd_text, flags=re.S)
    else:
        new_prd = prd_text.rstrip() + "\n\n" + sub_text
    new_prd = re.sub(r"^status: draft", "status: committed", new_prd, flags=re.M)
    p_path.write_text(new_prd)

    # append to active.md
    active_text = pathlib.Path(active_path).read_text()
    header = f"\n## PRD subtasks of {parent_id}\n"
    new_active = active_text.rstrip() + "\n" + header + "\n" + "\n\n".join(out_blocks) + "\n"
    pathlib.Path(active_path).write_text(new_active)
    # log — intentionally brief: no prompt content, no secrets
    ts = datetime.datetime.now(datetime.timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")
    with open(log_path, "a") as fh:
        fh.write(f"## [{ts}] prd-decompose | {parent_id} | {agent_id} | tasks={len(out_blocks)} stub={used_stub}\n")
    print(f"committed {len(out_blocks)} subtasks to active.md and updated {prd_path} (stub={used_stub}):")
    for prio, full_id, title, _, _ in normalized:
        print(f"  [{prio}] {full_id} — {title}")
else:
    print(f"# DRY-RUN decompose: {len(out_blocks)} task block(s) (stub={used_stub}), no writes")
    print(f"# parent: {parent_id}")
    print()
    print("\n\n".join(out_blocks))
PY
    )
    echo "$_result"
    if [ "$_do_commit" -eq 1 ]; then
      "$(dirname "${BASH_SOURCE[0]}")/brain-index" rebuild >/dev/null 2>&1 &
    fi
    ;;
  dry-run)
    [ -z "$id" ] && { echo "task id required"; exit 1; }
    f="$PRD_DIR/$id.md"
    [ ! -f "$f" ] && { echo "no PRD at $f"; exit 1; }
    python3 - "$f" "$id" "$(dirname "${BASH_SOURCE[0]}")" <<'PY'
import sys, re, pathlib

import brain_task_parser
prd_path, parent_id = sys.argv[1:3]
prd_text = pathlib.Path(prd_path).read_text()
m = re.search(r"^## Subtasks\s*$(.+?)(?=^## |\Z)", prd_text, re.S | re.M)
if not m:
    print("no ## Subtasks section in PRD")
    sys.exit(1)
sub_text = m.group(1)
blocks = brain_task_parser.find_blocks(sub_text)
if not blocks:
    print("no subtasks found")
    sys.exit(1)

normalized = []
local_to_full = {}
for b in blocks:
    parsed = brain_task_parser.parse_block(b)
    if not parsed:
        print(f"invalid subtask header: {b.splitlines()[0]}")
        sys.exit(1)
    prio, local_id, title = parsed["prio"], parsed["id"], parsed["title"]
    full_id = local_id if local_id.startswith("t-") else f"{parent_id}-{local_id}"
    local_to_full[local_id] = full_id
    normalized.append((prio, full_id, title, b))

out_blocks = []
errors = []
for prio, full_id, title, original in normalized:
    body_lines = original.split("\n")[1:]
    new_body = []
    for line in body_lines:
        line2 = re.sub(
            r"depends_on: *\[([^\]]*)\]",
            lambda mm: "depends_on: [" + ", ".join(
                local_to_full.get(d.strip(), d.strip())
                for d in mm.group(1).split(",") if d.strip()
            ) + "]",
            line,
        )
        new_body.append(line2)
    if not any("parent:" in line for line in new_body):
        new_body.insert(0, f"      parent: {parent_id}")
    if not any(re.match(r"\s*role:\s*\S+", line) for line in new_body):
        new_body.insert(1, "      role: developer")
    if not any(re.match(r"\s*mode:\s*\S+", line) for line in new_body):
        new_body.insert(2, "      mode: solo")
    if not any(re.match(r"\s*depends_on:\s*\[", line) for line in new_body):
        new_body.insert(3, "      depends_on: []")
    if not any(re.match(r"\s*acceptance:\s*\S+", line) for line in new_body):
        errors.append(f"{full_id}: missing acceptance")
    out_blocks.append(f"- [ ] [{prio}] {full_id} — {title}\n" + "\n".join(new_body))

if errors:
    print("invalid PRD subtasks:")
    for e in errors:
        print(f"  - {e}")
    sys.exit(1)

print(f"# DRY-RUN: {len(out_blocks)} task block(s), no writes")
print(f"# parent: {parent_id}")
print()
print("\n\n".join(out_blocks))
PY
    ;;
  commit)
    [ -z "$id" ] && { echo "task id required"; exit 1; }
    f="$PRD_DIR/$id.md"
    [ ! -f "$f" ] && { echo "no PRD at $f"; exit 1; }
    grep -q "^status: committed" "$f" && { echo "already committed"; exit 1; }
    # парсим subtasks через python и аппендим в active.md
    python3 - "$f" "$A" "$id" "$LOG" "$(dirname "${BASH_SOURCE[0]}")" <<'PY'
import sys, re, datetime, pathlib

import brain_task_parser
prd_path, active_path, parent_id, log_path = sys.argv[1:5]
prd_text = pathlib.Path(prd_path).read_text()

# найти секцию Subtasks
m = re.search(r"^## Subtasks\s*$(.+?)(?=^## |\Z)", prd_text, re.S | re.M)
if not m:
    print("no ## Subtasks section in PRD")
    sys.exit(1)
sub_text = m.group(1)

# каждый блок: "- [ ] [Pn] <id> — title" + 2-N строк отступа
blocks = brain_task_parser.find_blocks(sub_text)
if not blocks:
    print("no subtasks found")
    sys.exit(1)

# нормализация: заменить локальный id (s1, s2, ...) на полный
# и в depends_on тоже заменить
normalized = []
local_to_full = {}

for b in blocks:
    parsed = brain_task_parser.parse_block(b)
    if not parsed:
        continue
    prio, local_id = parsed["prio"], parsed["id"]
    title = parsed["title"]
    # если local_id уже выглядит как полный (t-...) — оставить, иначе префикс родителя
    if local_id.startswith("t-"):
        full_id = local_id
    else:
        full_id = f"{parent_id}-{local_id}"
    local_to_full[local_id] = full_id
    normalized.append((prio, full_id, title, b))

# теперь переписать depends_on в каждом блоке на полные id
out_blocks = []
for prio, full_id, title, original in normalized:
    body_lines = original.split("\n")[1:]  # без заголовка
    new_body = []
    for line in body_lines:
        line2 = re.sub(
            r"depends_on: *\[([^\]]*)\]",
            lambda mm: "depends_on: [" + ", ".join(
                local_to_full.get(d.strip(), d.strip())
                for d in mm.group(1).split(",") if d.strip()
            ) + "]",
            line,
        )
        # добавим parent: <parent_id> если ещё нет
        new_body.append(line2)

    has_parent = any("parent:" in l for l in new_body)
    if not has_parent:
        # вставим в начало body
        new_body.insert(0, f"      parent: {parent_id}")

    block_out = f"- [ ] [{prio}] {full_id} — {title}\n" + "\n".join(new_body)
    out_blocks.append(block_out)

# аппендим в active.md
active_text = pathlib.Path(active_path).read_text()
header = f"\n## PRD subtasks of {parent_id}\n"
new_active = active_text.rstrip() + "\n" + header + "\n" + "\n\n".join(out_blocks) + "\n"
pathlib.Path(active_path).write_text(new_active)

# меняем status в PRD
new_prd = re.sub(r"^status: draft\s*$", "status: committed", prd_text, count=1, flags=re.M)
pathlib.Path(prd_path).write_text(new_prd)

# лог
ts = datetime.datetime.now(datetime.timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")
with open(log_path, "a") as f:
    f.write(f"## [{ts}] prd-commit | {parent_id} | {len(normalized)} subtasks\n")

print(f"committed {len(normalized)} subtasks to active.md:")
for prio, full_id, title, _ in normalized:
    print(f"  [{prio}] {full_id} — {title}")
PY
    "$(dirname "${BASH_SOURCE[0]}")/brain-index" rebuild >/dev/null 2>&1 &
    ;;
  status)
    [ -z "$id" ] && { echo "task id required"; exit 1; }
    f="$PRD_DIR/$id.md"
    [ ! -f "$f" ] && { echo "no PRD"; exit 1; }
    echo "PRD: $f"
    grep -E "^status:" "$f"
    echo
    echo "Subtasks status:"
    # ищем все subtasks этого parent
    python3 - "$BRAIN/tasks/active.md" "$BRAIN/tasks/done.md" "$id" "$(dirname "${BASH_SOURCE[0]}")" <<'PY'
import sys, pathlib

import brain_task_parser
A, D, parent = sys.argv[1:4]
text = pathlib.Path(A).read_text() + "\n" + pathlib.Path(D).read_text()
for block in brain_task_parser.find_blocks(text):
    parsed = brain_task_parser.parse_block(block)
    if not parsed or parsed.get("parent") != parent:
        continue
    marker = {' ': '○', '~': '◐', 'x': '●', '!': '✗'}.get(parsed["state"], '?')
    print(f"  {marker} {parsed['id']}  {parsed['title'][:60]}")
PY
    ;;
  list)
    [ -z "$(ls "$PRD_DIR" 2>/dev/null | grep -v _TEMPLATE)" ] && { echo "(no PRDs)"; exit 0; }
    for f in "$PRD_DIR"/*.md; do
      [ "$(basename "$f")" = "_TEMPLATE.md" ] && continue
      pid=$(basename "$f" .md)
      stat=$(grep -E "^status:" "$f" | sed 's/status: *//')
      echo "$pid  [$stat]"
    done
    ;;
  auto-breakdown)
    [ -z "$id" ] && { echo "task id required"; exit 1; }
    _provider="${3:-$CLI_DEFAULT}"
    echo ">>> Decomposing $id via $_provider and committing..."
    "$0" decompose "$id" --llm "$_provider" --commit
    ;;
  *)
    cat <<USAGE
brain-prd — PRD-режим для крупных задач

  brain-prd init <task-id>                          создать PRD-файл по шаблону
  brain-prd decompose <task-id> --llm <provider>    авто-генерация subtasks через LLM
        [--dry-run]  вывод в stdout (по умолчанию)
        [--commit]   записать сабтаски в active.md
  brain-prd auto-breakdown <task-id> [<provider>]  сквозная генерация и коммит сабтасков
  brain-prd dry-run <task-id>                       проверить Subtasks без записи
  brain-prd commit <task-id>                        распарсить Subtasks и залить в active.md
  brain-prd status <task-id>                        прогресс по сабтаскам
  brain-prd list                                    все PRD

Workflow (с LLM):
  1. brain-task add "Внедрить X" --role architect  (вручную поправь mode: prd)
  2. brain-prd init <id>
  3. Заполнить prd/<id>.md — Context, Goals, Non-goals (Subtasks — опционально)
  4. brain-prd decompose <id> --llm claude --dry-run   ← preview
  5. brain-prd decompose <id> --llm claude --commit    ← write to active.md
  6. brain-task next --role developer  ← покажет первый available сабтаск
USAGE
    exit 1;;
esac
