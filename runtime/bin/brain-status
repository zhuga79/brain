#!/usr/bin/env python3
"""Read-only orchestration status for Brain."""

from __future__ import annotations

import argparse
import hashlib
import importlib.util
import json
import os
import re
import sys
import time
from collections import Counter
from pathlib import Path
from typing import Any

import brain_tasks
import brain_index
import brain_periodic
import brain_provider

TASK_RE = brain_tasks.TASK_RE  # re-export for backward compat


from brain_core.paths import brain_path, brain_system_path
from brain_core.version import core_location, core_version  # одна реализация на всю систему


def parse_tasks(path: Path) -> list[dict[str, Any]]:
    if not path.exists():
        return []
    return brain_tasks.parse_tasks(path.read_text(encoding="utf-8", errors="replace"))


def summarize_tasks(active: list[dict[str, Any]], done: list[dict[str, Any]]) -> dict[str, Any]:
    return {
        "active_count": len(active),
        "done_count": len(done),
        "states": dict(Counter(task["state"] for task in active)),
        "priorities": dict(Counter(task["priority"] for task in active)),
        "roles": dict(Counter(task["role"] or "unassigned" for task in active)),
        "modes": dict(Counter(task["mode"] or "unspecified" for task in active)),
    }


def read_locks(brain: Path) -> list[dict[str, Any]]:
    locks: list[dict[str, Any]] = []
    locks_dir = brain / ".locks"
    if not locks_dir.exists():
        return locks

    now = int(time.time())
    for lock_dir in sorted(path for path in locks_dir.iterdir() if path.is_dir()):
        owner_path = lock_dir / "owner"
        record: dict[str, Any] = {"task_id": lock_dir.name, "owner": "", "age_seconds": None, "ttl_seconds": None, "stale": None}
        if owner_path.exists():
            parts = owner_path.read_text(encoding="utf-8", errors="replace").strip().split("|")
            if len(parts) >= 3:
                record["owner"] = parts[0]
                try:
                    created = int(parts[1])
                    ttl = int(parts[2])
                    record["age_seconds"] = max(0, now - created)
                    record["ttl_seconds"] = ttl
                    record["stale"] = record["age_seconds"] > ttl
                except ValueError:
                    record["stale"] = None
        locks.append(record)
    return locks


def read_council(brain: Path) -> list[dict[str, Any]]:
    council_dir = brain / "council"
    if not council_dir.exists():
        return []

    councils: list[dict[str, Any]] = []
    for task_dir in sorted(path for path in council_dir.iterdir() if path.is_dir()):
        files = sorted(path.name for path in task_dir.iterdir() if path.is_file())
        councils.append({"task_id": task_dir.name, "files": files, "file_count": len(files)})
    return councils


def read_index(brain: Path) -> dict[str, Any]:
    status = brain_index.index_status(brain)
    if status.get("status") == "missing":
        status["next_step"] = "brain-index rebuild"
    elif status.get("health") == "stale":
        status["next_step"] = "brain-index rebuild"
    else:
        status["next_step"] = ""
    return status


def _sha256(path: Path) -> str:
    return hashlib.sha256(path.read_bytes()).hexdigest()


IGNORED_RUNTIME_BIN = {
    "launch-dashboard.sh": "wrapper-or-generated",
    "brain-mcp": "mcp-managed-launcher",
}

# Reverse-scan exceptions must stay narrow: only justified generated/managed
# installed brain-* entrypoints belong here.
IGNORED_INSTALLED_BRAIN_EXTRAS: dict[str, str] = {}
IGNORED_INSTALLED_BRAIN_EXTRAS["brain-mcp"] = "mcp-managed-launcher"


def detect_cli_parity(brain: Path) -> dict[str, Any]:
    system = brain_system_path(brain=brain)
    runtime_bin = system / "runtime" / "bin"
    installed_bin = Path.home() / ".local" / "bin"
    ignored: list[dict[str, str]] = []
    mismatches: list[dict[str, str]] = []
    missing: list[dict[str, str]] = []
    extras: list[dict[str, str]] = []
    matched = 0

    if not runtime_bin.is_dir():
        return {
            "status": "unavailable",
            "runtime_bin": str(runtime_bin),
            "installed_bin": str(installed_bin),
            "matched": 0,
            "ignored": [],
            "mismatches": [],
            "missing": [],
            "extras": [],
            "drift_count": 0,
        }

    canonical_names: set[str] = set()
    for source in sorted(path for path in runtime_bin.iterdir() if path.is_file()):
        name = source.name
        if name in IGNORED_RUNTIME_BIN:
            ignored.append({"name": name, "reason": IGNORED_RUNTIME_BIN[name]})
            continue
        if not name.startswith("brain-"):
            continue
        canonical_names.add(name)
        installed = installed_bin / name
        if not installed.exists():
            missing.append({"name": name, "source": str(source), "installed": str(installed)})
            continue
        if _sha256(source) != _sha256(installed):
            mismatches.append({"name": name, "source": str(source), "installed": str(installed)})
            continue
        matched += 1

    if installed_bin.is_dir():
        for installed in sorted(path for path in installed_bin.iterdir() if path.is_file()):
            name = installed.name
            if not name.startswith("brain-") or not os.access(installed, os.X_OK):
                continue
            if name in canonical_names:
                continue
            if name in IGNORED_INSTALLED_BRAIN_EXTRAS:
                ignored.append({"name": name, "reason": IGNORED_INSTALLED_BRAIN_EXTRAS[name]})
                continue
            extras.append({"name": name, "installed": str(installed)})

    drift_count = len(mismatches) + len(missing) + len(extras)
    return {
        "status": "ok" if drift_count == 0 else "drift",
        "runtime_bin": str(runtime_bin),
        "installed_bin": str(installed_bin),
        "matched": matched,
        "ignored": ignored,
        "mismatches": mismatches,
        "missing": missing,
        "extras": extras,
        "drift_count": drift_count,
    }


def _load_mcp_packaging(packaging_tool: Path):
    spec = importlib.util.spec_from_file_location("brain_mcp_packaging", packaging_tool)
    if spec is None or spec.loader is None:
        raise ImportError(f"cannot load {packaging_tool}")
    module = importlib.util.module_from_spec(spec)
    spec.loader.exec_module(module)
    return module


def detect_mcp_parity(brain: Path) -> dict[str, Any]:
    system = brain_system_path(brain=brain)
    install_root = Path(os.environ.get("BRAIN_MCP_DIR", str(Path.home() / ".local" / "share" / "brain-mcp"))).expanduser()
    launcher = Path(os.environ.get("BRAIN_MCP_LAUNCHER", str(Path.home() / ".local" / "bin" / "brain-mcp"))).expanduser()
    installer = system / "install-brain-mcp.sh"
    packaging_tool = system / "runtime" / "mcp" / "packaging.py"
    remediation_cmd = f"bash {installer}" if installer.is_file() else "install-brain-mcp.sh unavailable"
    present_tree = any(
        path.exists()
        for path in (
            install_root / "manifest.json",
            install_root / ".venv",
            install_root / "runtime",
        )
    )
    launcher_present = launcher.exists()
    if not present_tree and not launcher_present:
        return {
            "status": "missing",
            "install_root": str(install_root),
            "launcher": str(launcher),
            "launcher_present": False,
            "file_count": 0,
            "matched": 0,
            "missing": [],
            "extras": [],
            "mismatches": [],
            "drift_count": 0,
            "remediation": f"optional install absent; run {remediation_cmd}",
        }
    if not present_tree and launcher_present:
        return {
            "status": "drift",
            "install_root": str(install_root),
            "launcher": str(launcher),
            "launcher_present": True,
            "file_count": 0,
            "matched": 0,
            "missing": [{"path": "runtime/"}],
            "extras": [],
            "mismatches": [],
            "drift_count": 1,
            "remediation": f"stale launcher without installed runtime; run {remediation_cmd}",
        }
    if not packaging_tool.is_file():
        return {
            "status": "unavailable",
            "install_root": str(install_root),
            "launcher": str(launcher),
            "launcher_present": launcher_present,
            "file_count": 0,
            "matched": 0,
            "missing": [],
            "extras": [],
            "mismatches": [],
            "drift_count": 0,
            "remediation": f"missing packaging tool: {packaging_tool}",
        }
    try:
        packaging = _load_mcp_packaging(packaging_tool)
        verify = packaging.verify_install(system, install_root)
    except Exception as exc:
        return {
            "status": "error",
            "install_root": str(install_root),
            "launcher": str(launcher),
            "launcher_present": launcher_present,
            "file_count": 0,
            "matched": 0,
            "missing": [],
            "extras": [],
            "mismatches": [],
            "drift_count": 0,
            "remediation": f"verify failed: {exc}",
        }

    verify["install_root"] = str(install_root)
    verify["launcher"] = str(launcher)
    verify["launcher_present"] = launcher_present
    # matched counts manifest files that verified OK — a fact about the tree.
    # Compute it before the launcher note is folded into `missing`, so a stale
    # launcher (its own diagnostic, carried by launcher_present + drift_count)
    # never makes the runtime tree look one file short.
    verify["matched"] = verify.get("file_count", 0) - len(verify.get("missing", [])) - len(verify.get("mismatches", []))
    if not launcher_present:
        verify["status"] = "drift"
        verify["missing"] = [{"path": "launcher"}] + verify.get("missing", [])
        verify["drift_count"] = verify.get("drift_count", 0) + 1
    if verify.get("status") == "ok":
        verify["remediation"] = ""
    else:
        verify["remediation"] = f"refresh existing install via {remediation_cmd}"
    return verify


def collect_status(brain: Path) -> dict[str, Any]:
    active = parse_tasks(brain / "tasks" / "active.md")
    done = parse_tasks(brain / "tasks" / "done.md")
    locks = read_locks(brain)
    councils = read_council(brain)
    return {
        "brain": str(brain),
        "system": str(brain_system_path(brain=brain)),
        "tasks": {
            "summary": summarize_tasks(active, done),
            "active": active,
            "done": done,
        },
        "locks": {
            "count": len(locks),
            "stale_count": sum(1 for lock in locks if lock.get("stale") is True),
            "items": locks,
        },
        "council": {
            "count": len(councils),
            "items": councils,
        },
        "index": read_index(brain),
        "providers": brain_provider.collect_provider_status(brain),
        "cli_parity": detect_cli_parity(brain),
        "mcp_parity": detect_mcp_parity(brain),
        "periodic": brain_periodic.collect_periodic_status(),
    }


def format_counter(counter: dict[str, int], labels: dict[str, str] | None = None) -> str:
    if not counter:
        return "-"
    labels = labels or {}
    return ", ".join(f"{labels.get(key, key)}:{counter[key]}" for key in sorted(counter))


def print_text(status: dict[str, Any]) -> None:
    summary = status["tasks"]["summary"]
    index = status["index"]

    print(f"Brain: {status['brain']}")
    print(f"System: {status.get('system', status['brain'])}")
    # Версия и путь ядра: без них «правка не действует» неотличимо от
    # «исполняется другая копия» — за этим мы и гонялись всю дорогу.
    print(f"Core: {core_version()} ({core_location()})")
    print(f"Tasks: active={summary['active_count']} done={summary['done_count']}")
    print(f"  states: {format_counter(summary['states'], {' ': 'open', '~': 'in_progress', 'x': 'done', '!': 'blocked'})}")
    print(f"  priorities: {format_counter(summary['priorities'])}")
    print(f"  roles: {format_counter(summary['roles'])}")
    print(f"  modes: {format_counter(summary['modes'])}")
    print(f"Locks: {status['locks']['count']} stale={status['locks']['stale_count']}")
    print(f"Council: {status['council']['count']}")
    provider_roles = status.get("providers", {}).get("roles", {})
    if provider_roles:
        configured = sum(1 for info in provider_roles.values() if info.get("preferred"))
        unavailable = sum(len(info.get("unavailable", [])) for info in provider_roles.values())
        print(f"Providers: roles={len(provider_roles)} configured={configured} unavailable={unavailable}")
    health = index.get("health", index.get("status", "unknown"))
    idx_status = "present" if index.get("status") != "missing" else "missing"
    health_flag = " [WARN: run brain-index rebuild]" if health in ("stale", "missing", "error") else ""
    print(f"Index: {idx_status} health={health}{health_flag}")
    if index.get("status") in ("present", "ok", "stale"):
        print(
            "  "
            f"generated_at={index.get('generated_at', '-')}"
            f" pages={index.get('page_count', 0)}"
            f" raw={index.get('raw_count', 0)}"
            f" links={index.get('link_count', 0)}"
            f" search_docs={index.get('search_docs', 0)}"
        )
    if index.get("next_step"):
        print(f"  → next step: {index['next_step']}")
    if index.get("stale_files"):
        print(f"  stale files ({len(index['stale_files'])}): {', '.join(index['stale_files'][:5])}"
              + (" ..." if len(index["stale_files"]) > 5 else ""))
    cli_parity = status.get("cli_parity", {})
    if cli_parity:
        parity_status = cli_parity.get("status", "unknown")
        drift_count = cli_parity.get("drift_count", 0)
        warn = " [WARN: reinstall from canonical source]" if drift_count else ""
        print(
            "CLI parity: "
            f"status={parity_status} matched={cli_parity.get('matched', 0)}"
            f" drift={drift_count} ignored={len(cli_parity.get('ignored', []))}{warn}"
        )
        if drift_count:
            offenders = [
                item["name"]
                for item in (
                    cli_parity.get("mismatches", [])
                    + cli_parity.get("missing", [])
                    + cli_parity.get("extras", [])
                )
            ]
            print(f"  drifted: {', '.join(offenders[:8])}" + (" ..." if len(offenders) > 8 else ""))
    mcp_parity = status.get("mcp_parity", {})
    if mcp_parity:
        parity_status = mcp_parity.get("status", "unknown")
        drift_count = mcp_parity.get("drift_count", 0)
        extras_count = len(mcp_parity.get("extras", []))
        if parity_status == "missing":
            suffix = " [INFO: optional install absent]"
        elif parity_status in ("drift", "error", "unavailable"):
            suffix = " [WARN: refresh via install-brain-mcp.sh]"
        else:
            suffix = ""
        print(
            "MCP parity: "
            f"status={parity_status} matched={mcp_parity.get('matched', 0)}"
            f" drift={drift_count} extras={extras_count}{suffix}"
        )
        if mcp_parity.get("remediation"):
            print(f"  remediation: {mcp_parity['remediation']}")
        if drift_count:
            offenders = [
                item["path"]
                for item in (
                    mcp_parity.get("mismatches", [])
                    + mcp_parity.get("missing", [])
                    + mcp_parity.get("extras", [])
                )
            ]
            print(f"  drifted: {', '.join(offenders[:8])}" + (" ..." if len(offenders) > 8 else ""))
    periodic = status.get("periodic", {})
    if periodic:
        # t-2026-08-16-operator-timers-dead-user-serv: таймер, который просто
        # активен, ничего не говорит о том, отработал ли он в systemd-контексте
        # успешно — только это делает провал видимым без ручного journalctl.
        if not periodic.get("available"):
            print("Periodic units: systemctl --user unavailable — status unknown")
        else:
            failed = periodic.get("failed", [])
            unknown = periodic.get("unknown", [])
            not_installed = periodic.get("not_installed", [])
            warn = " [WARN: journalctl --user -u <unit>.service]" if failed else ""
            print(
                "Periodic units: "
                f"{len(periodic.get('units', [])) - len(failed) - len(unknown) - len(not_installed)}/"
                f"{len(periodic.get('units', []))} healthy"
                f"{warn}"
            )
            if failed:
                print(f"  FAILED: {', '.join(failed)}")
            if not_installed:
                print(f"  not installed: {', '.join(not_installed)}")
            if unknown:
                print(f"  unknown: {', '.join(unknown)}")


def main() -> int:
    parser = argparse.ArgumentParser(description="Read-only Brain orchestration status.")
    parser.add_argument("--brain", default=None, help="Brain path. Defaults to BRAIN_PATH or ~/brain.")
    parser.add_argument("--json", action="store_true", help="Emit machine-readable JSON.")
    args = parser.parse_args()

    brain = brain_path(args.brain)
    if not brain.exists():
        print(f"ERROR: Brain path does not exist: {brain}", file=os.sys.stderr)
        return 1

    status = collect_status(brain)
    if args.json:
        print(json.dumps(status, ensure_ascii=False, indent=2, sort_keys=True))
    else:
        print_text(status)
    return 0


if __name__ == "__main__":
    # `brain-status --json | grep -q ...` — типичный вызов из smoke-кейсов и
    # `brain-ops`; grep закрывает читающий конец, как только находит
    # совпадение, не дожидаясь остального вывода. Этот бинарь раньше гасил
    # BrokenPipeError сам, отдельным try/except — теперь то же самое общее
    # место, что и у остальных семи CLI с тем же паттерном использования:
    # смысл переноса не в поведении (оно не изменилось), а в том, что
    # исправление гарантии/сообщения не нужно копировать в восемь файлов.
    from brain_core.cli_entry import run_cli

    run_cli(main)
