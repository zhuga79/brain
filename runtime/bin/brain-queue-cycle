#!/usr/bin/env python3
"""Ежедневный queue-cycle: предложения запусков для подтверждения с дашборда.

Команда никогда не запускает агентов вживую. Логика живёт в
`brain_app.cycles.queue`, здесь — только точка входа.
"""

from __future__ import annotations

from brain_app.cycles import queue, runner


def main(argv: list[str] | None = None) -> int:
    return runner.dispatch(queue.SPEC, argv)


if __name__ == "__main__":
    raise SystemExit(main())
