#!/usr/bin/env bash
# brain-council-tui <task-id> [--dry-run]
# Polished tmux layout for an interactive council review (surface: interactive).
# Large live overview pane (task + auto-refreshing council status) on the left,
# one prompt-preloaded pane per council role on the right. Styled status bar,
# pane titles and colors. See wiki/decision-interactive-surface.md.
set -euo pipefail
# shellcheck source=./brain-common
source "$(dirname "${BASH_SOURCE[0]}")/brain-common"

task="${1:-}"; shift || true
dry=0
for a in "$@"; do case "$a" in --dry-run) dry=1;; esac; done
[ -z "$task" ] && { echo "usage: brain-council-tui <task-id> [--dry-run]" >&2; exit 1; }

# --- gather task metadata via the parser (single python call) ---
meta=$("$_BIN_DIR/brain-task" show "$task" --json 2>/dev/null | python3 -c '
import json,sys,re
d=json.load(sys.stdin).get("task",{})
roles=d.get("council") or ([d["role"]] if d.get("role") else [])
raw=d.get("raw","")
m=re.search(r"ref:\s*(.+)",raw)
print("ROLES\t"+" ".join(roles))
print("TITLE\t"+d.get("title",""))
print("ACCEPT\t"+(d.get("acceptance","") or ""))
print("REF\t"+(m.group(1).strip() if m else ""))
print("SURF\t"+(d.get("surface","") or "headless"))
print("GATE\t"+(d.get("gate","") or "-"))
') || { echo "task not found: $task" >&2; exit 1; }

roles=$(printf '%s\n' "$meta" | sed -n 's/^ROLES\t//p')
title=$(printf '%s\n' "$meta" | sed -n 's/^TITLE\t//p')
accept=$(printf '%s\n' "$meta" | sed -n 's/^ACCEPT\t//p')
ref=$(printf '%s\n' "$meta" | sed -n 's/^REF\t//p')
surf=$(printf '%s\n' "$meta" | sed -n 's/^SURF\t//p')
gate=$(printf '%s\n' "$meta" | sed -n 's/^GATE\t//p')
[ -z "$roles" ] && { echo "no council roles on $task" >&2; exit 1; }

S="council-$task"
cdir="$COUNCIL/$task"

if [ "$dry" = 1 ]; then
  echo "session : $S"
  echo "surface : $surf   gate: $gate"
  echo "title   : $title"
  echo "roles   : $roles"
  echo "panes   : overview + $(echo "$roles" | wc -w) role panes (main-vertical)"
  exit 0
fi

command -v tmux >/dev/null || { echo "tmux not installed" >&2; exit 2; }

# --- overview pane script (auto-refreshing) ---
ov="$(mktemp "${TMPDIR:-/tmp}/brain-council-ov-XXXX.sh")"
cat > "$ov" <<OV
#!/usr/bin/env bash
BIN="$_BIN_DIR"; task="$task"
title=$(printf '%q' "$title"); accept=$(printf '%q' "$accept"); ref=$(printf '%q' "$ref")
surf="$surf"; gate="$gate"
while true; do
  clear
  printf '\033[1;38;5;39m╔════════════════════════════════════════════════╗\033[0m\n'
  printf '\033[1;38;5;39m║\033[0m  \033[1;97m🧠 COUNCIL REVIEW\033[0m\n'
  printf '\033[1;38;5;39m╚════════════════════════════════════════════════╝\033[0m\n'
  printf '  \033[1m%s\033[0m\n' "\$title"
  printf '  \033[2m%s\033[0m\n\n' "$task"
  printf '  \033[38;5;213m◆ surface:\033[0m %s   \033[38;5;213m◆ gate:\033[0m %s\n\n' "\$surf" "\$gate"
  printf '  \033[1;33m▸ acceptance\033[0m\n    %s\n\n' "\$accept"
  [ -n "\$ref" ] && printf '  \033[1;33m▸ ref\033[0m\n    %s\n\n' "\$ref"
  printf '  \033[1;36m▸ council status\033[0m\n'
  "\$BIN/brain-council" status "$task" 2>/dev/null | sed 's/^/    /'
  printf '\n  \033[2mauto-refresh 5s · next window: Ctrl-b o · scroll: Ctrl-b [ · detach: Ctrl-b d\033[0m\n'
  sleep 5
done
OV
chmod +x "$ov"

# --- build session ---
tmux has-session -t "$S" 2>/dev/null && tmux kill-session -t "$S"
# kill the raw brain-launch session for the same task if present
tmux has-session -t "brain-$task" 2>/dev/null && tmux kill-session -t "brain-$task"

tmux new-session -d -s "$S" -n review -x "${BRAIN_TUI_COLS:-232}" -y "${BRAIN_TUI_ROWS:-58}"
tmux select-pane  -t "$S:review.0" -T "overview"
tmux send-keys    -t "$S:review.0" "bash '$ov'" C-m

for r in $roles; do
  tmux split-window -t "$S:review" -v
  tmux select-pane  -t "$S:review" -T "$r"
  pf="$cdir/.prompt-$r.txt"
  cmd="clear; "
  cmd+="'$_BIN_DIR/brain-run' --role $r --task $task >'$pf' 2>/dev/null; "
  cmd+="printf '\033[1;38;5;213m●\033[0m \033[1;97m%s\033[0m\n' '$r'; "
  cmd+="printf '\033[2m─────────────────────────────\033[0m\n'; "
  cmd+="printf '  \033[1;33m▶ your opinion\033[0m  council/$task/$r.md\n'; "
  cmd+="printf '  \033[2mfull prompt\033[0m    %s\n' '$pf'; "
  cmd+="printf '  \033[2medit\033[0m           \${EDITOR:-nano} council/$task/$r.md\n'; "
  cmd+="printf '  \033[2mwrite independently — do not read peers first\033[0m\n'"
  tmux send-keys -t "$S:review" "$cmd" C-m
done

# --- layout + styling ---
tmux set-window-option -t "$S:review" main-pane-width 96
tmux select-layout      -t "$S:review" main-vertical
tmux set-option -t "$S" pane-border-status top
tmux set-option -t "$S" pane-border-format " #[bold]#{pane_index} #{pane_title} "
tmux set-option -t "$S" pane-active-border-style "fg=colour213"
tmux set-option -t "$S" pane-border-style "fg=colour24"
tmux set-option -t "$S" status-style "bg=colour24,fg=colour231"
tmux set-option -t "$S" status-left  "#[bold,bg=colour213,fg=colour16] 🧠 council #[default,bg=colour24,fg=colour231] $task "
tmux set-option -t "$S" status-left-length 80
tmux set-option -t "$S" status-right "#[bold]surface:$surf · gate:$gate #[default] %H:%M "
tmux select-pane -t "$S:review.0"

echo "✓ polished council session: $S"
echo "  attach : tmux attach -t $S"
echo "  kill   : tmux kill-session -t $S"
