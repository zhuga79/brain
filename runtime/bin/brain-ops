#!/usr/bin/env bash
# brain-ops {watch|refresh|update} — Background operational maintenance.
#
# watch   : run a loop that refreshes provider health, metrics and gates.
# refresh : run one-shot refresh of all data supply components.
# update  : git pull the system checkout, reinstall CLI, run tests.

set -euo pipefail
source "$(dirname "${BASH_SOURCE[0]}")/brain-common"

refresh() {
  echo ">>> [brain-ops] Refreshing data supply..."
  
  # 1. Provider health (probes)
  "${_BIN_DIR}/brain-provider" collect >/dev/null 2>&1 || true
  
  # 2. Token metrics
  "${_BIN_DIR}/brain-compact" --metrics-only >/dev/null 2>&1 || true
  
  # 3. Policy gates
  "${_BIN_DIR}/brain-policy" check >/dev/null 2>&1 || true
  
  # 4. Index rebuild (best effort)
  "${_BIN_DIR}/brain-index" rebuild --with-obsidian >/dev/null 2>&1 || true
  
  echo ">>> [brain-ops] Done."
}

resolve_system_checkout() {
  local cand
  for cand in "${BRAIN_SYSTEM_PATH:-}" "$BRAIN"; do
    [ -n "$cand" ] || continue
    if [ -f "$cand/setup-brain-v2.sh" ]; then
      printf '%s\n' "$cand"
      return 0
    fi
  done
  echo "brain-ops update: cannot find system checkout (set BRAIN_SYSTEM_PATH)" >&2
  return 1
}

# Голый `git pull` без remote/ветки опирается на настроенный upstream
# текущей ветки. На чекауте, который ведут через явный `git push origin
# <branch>` (без `git push -u`), upstream может не быть настроен вовсе —
# тогда git откажет сырым текстом без подсказки, что делать. Молча
# подставлять `origin` тоже нельзя: в чекауте может быть несколько remote
# (см. этот чекаут: origin и user-hp-system), и угадывание уведёт pull не
# туда. Поэтому: проверяем upstream явно и, если его нет, отказываем с
# готовой командой-подсказкой — включая имя remote, если он ровно один.
require_pull_target() {
  local root="$1"
  local branch remotes remote_count remote

  branch="$(git -C "$root" symbolic-ref --quiet --short HEAD 2>/dev/null || true)"
  if [ -z "$branch" ]; then
    echo "brain-ops update: $root is in detached HEAD, cannot determine a branch to pull" >&2
    echo "  fix: git -C \"$root\" checkout <branch>" >&2
    return 1
  fi

  if git -C "$root" rev-parse --abbrev-ref --symbolic-full-name "${branch}@{upstream}" >/dev/null 2>&1; then
    return 0
  fi

  remotes="$(git -C "$root" remote)"
  remote_count="$(printf '%s\n' "$remotes" | grep -c . || true)"
  echo "brain-ops update: branch '$branch' in $root has no upstream configured" >&2
  if [ "$remote_count" = 1 ]; then
    remote="$remotes"
    echo "  fix: git -C \"$root\" branch --set-upstream-to=${remote}/${branch} ${branch}" >&2
  elif [ "$remote_count" = 0 ]; then
    echo "  fix: no remotes configured in $root; add one first (git -C \"$root\" remote add origin <url>)" >&2
  else
    echo "  fix: git -C \"$root\" branch --set-upstream-to=<remote>/${branch} ${branch}" >&2
    echo "  configured remotes: $(printf '%s ' $remotes)" >&2
  fi
  return 1
}

update() {
  local root
  root="$(resolve_system_checkout)"
  if [ ! -d "$root/.git" ]; then
    echo "brain-ops update: $root is not a git checkout" >&2
    exit 1
  fi
  require_pull_target "$root" || exit 1
  echo ">>> [brain-ops] pull $root"
  git -C "$root" pull
  echo ">>> [brain-ops] install"
  BRAIN_SYSTEM_PATH="$root" bash "$root/setup-brain-v2.sh"
  echo ">>> [brain-ops] tests"
  bash "$root/tests/run.sh"
}

usage() {
  cat <<USAGE
brain-ops — фоновое обслуживание и актуализация данных

  brain-ops refresh       актуализировать здоровье провайдеров, метрики и политики
  brain-ops watch         запустить цикл фонового обновления (300с)
  brain-ops update        git pull системного чекаута, install, тесты

USAGE
}

cmd="${1:-help}"
case "$cmd" in
  refresh) refresh ;;
  update) update ;;
  watch)
    interval="${BRAIN_OPS_INTERVAL:-300}"
    echo ">>> [brain-ops] Starting ops watch loop (interval: ${interval}s)"
    while true; do
      refresh
      sleep "$interval"
    done
    ;;
  *) usage; exit 1 ;;
esac
