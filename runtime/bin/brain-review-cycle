#!/usr/bin/env python3
"""Периодический review-cycle: детерминированный обзор очереди и репозитория.

Команда не запускает LLM-агентов. Логика живёт в `brain_app.cycles.review`,
здесь — только точка входа.
"""

from __future__ import annotations

from brain_app.cycles import review, runner


def main(argv: list[str] | None = None) -> int:
    return runner.dispatch(review.SPEC, argv)


if __name__ == "__main__":
    raise SystemExit(main())
