{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Orchestrator Handoff",
  "type": "object",
  "properties": {
    "reason": {
      "type": "string",
      "enum": [
        "limit-near",
        "limit-exhausted",
        "rate-limit",
        "context-bleed",
        "manual",
        "fallback",
        "done"
      ]
    }
  },
  "required": ["reason"]
}
